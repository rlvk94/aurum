# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# ── Drizzle / Database ──────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5434/aurum"

# ── BetterAuth ──────────────────────────────────────────────────────────────
# Random secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL of the application (e.g. http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"

# ── PostHog ─────────────────────────────────────────────────────────────────
# Leave unset in development to disable.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ── Email (Resend) ──────────────────────────────────────────────────────────
# API key from https://resend.com/api-keys. Required in production; when unset
# in development, emails are logged to the console instead of being sent.
RESEND_API_KEY=""

# From address for transactional emails. Use a verified sender on a verified
# domain once DNS is set up. Until then, `onboarding@resend.dev` works for
# testing but can only send to the account owner's email.
EMAIL_FROM="Aurum <onboarding@resend.dev>"

# Inbox that receives marketing-page contact-form submissions. Required in
# production; when unset in development the submission is logged to the console
# instead of being sent.
CONTACT_TO_EMAIL=""

# ── Application ─────────────────────────────────────────────────────────────
# Environment tag: development | staging | production
NEXT_PUBLIC_APP_ENV="development"
